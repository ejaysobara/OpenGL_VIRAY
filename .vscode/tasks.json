{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenGL Program",
            "type": "shell",
            "command": "C:\\Program Files (x86)\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
